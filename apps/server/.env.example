# MongoDB connection string (local docker-compose single-node replica set)
MONGODB_URI=mongodb://127.0.0.1:27018/piyonpay?directConnection=true

# HTTP port
PORT=3000

# Room documents expire this many hours after last activity (sliding TTL)
ROOM_TTL_HOURS=24

# After banker closes, admin-only hold before auto-delete (minutes)
ROOM_ADMIN_HOLD_MINUTES=15

# Rate limiting (Nest Throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_TRANSFER_LIMIT=20
